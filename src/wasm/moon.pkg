import {
  "mizchi/oci_wasm/types",
  "mizchi/oci_wasm/discovery",
  "mizchi/oci_wasm/oci",
  "moonbitlang/async/js_async",
  "moonbitlang/core/json",
  "moonbitlang/core/builtin",
}

warnings = "-14"

options(
  "is-main": true,
  link: {
    "js": {
      "exports": [
        "discover",
        "list_tags",
        "get_manifest",
        "get_wasm_config",
        "pull_wasm",
      ],
    },
  },
  "supported-targets": [ "js" ],
)
